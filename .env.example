# All services are disabled until explicitly configured. Never commit .env.local.
ACCOUNTPILOT_MEMBERSHIP_ENABLED=false
# Optional local fictional demo. Always blocked by production builds.
ACCOUNTPILOT_ENABLE_LOCAL_DEMO=false
APP_URL=http://localhost:3000
# Supabase project URL and publishable key (server-side in this implementation).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key: billing webhook only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Use Stripe TEST mode during setup. No live payment credentials were configured.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
ACCOUNTPILOT_ALLOW_LIVE_PAYMENTS=false
